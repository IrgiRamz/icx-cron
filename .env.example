# Iconix Cron Configuration Example File
# Copy this file to .env and fill in your values

# Server Settings
PORT=8080

# Database Settings
DB_PATH=cron.db

# Authentication Credentials
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Easycron REST API Security Key
API_KEY=

# Worker Engine Settings
MAX_WORKERS=30
LOG_RETENTION_DAYS=7
